# .pylintrc

[MASTER]
# The maximum number of line characters for a module (default: 100).
max-line-length=120

# List of plugins to load, in addition to the default ones
# load-plugins=

[MESSAGES CONTROL]
# Disable the "missing docstring" warning
disable=
    missing-docstring,
    too-few-public-methods,
    too-many-arguments

[REPORTS]
# Set the output format. You can change this to "text", "colorized", etc.
output-format=text
# Set the verbosity level (0 - 3). Higher values show more info.
verbosity=1

[DESIGN]
# Maximum number of attributes for a class (default: 7)
max-attributes=10

# Maximum number of methods for a class (default: 20)
max-methods=15

[TYPECHECK]
# List of directories to be treated as containing Python packages
# init-hook=

[FORMAT]
# Use consistent indentation (default: 4 spaces)
indent-string='    '

[SIMILARITIES]
# Minimum lines of code that make a code segment similar to another
min-similarity-lines=4

[LOGGING]
# Logging level (default: 1)
# 0 - Disable logging
# 1 - Errors only
# 2 - Warnings and Errors
# 3 - Info, Warnings, Errors
logging-level=2

[DESIGN]
# Maximum allowed complexity (default: 10)
max-complexity=10

[IMPORTS]
# How to handle imports
# This is to check if the imports are in the correct order
known-third-party=numpy,matplotlib

[DOCSTRING]
# Whether or not docstrings are required for modules, classes, and functions
# docstring-min-length=10
